# ───────────────────────── Pathment server — environment ─────────────────────────
# Copy to `.env` and fill in. For production deploy details see DEPLOY.md.

# ── Core ──
NODE_ENV=production
PORT=5000
# Domain Caddy serves the API on (used by docker-compose + Caddyfile). e.g. api.pathment.me
API_DOMAIN=api.pathment.me
# Comma-separated allowed origins for CORS + Socket.IO (your Vercel frontend URL(s)).
# Supports * wildcards, e.g. https://*.vercel.app
# Keep the wildcard during the legacy-domain migration so signed-in browsers
# can request their one-time handoff code from devweekends.pathment.me.
CLIENT_URL=https://app.pathment.me,https://pathment.me,https://*.pathment.me
APP_URL=https://app.pathment.me
# Keep false on production until the remaining isolation audit is complete.
MULTI_TENANT_WORKSPACES_ENABLED=false
LINK_URL=https://links.pathment.me
TENANT_DOMAIN_SUFFIX=pathment.me
DEFAULT_WORKSPACE_SLUG=devweekends
DEFAULT_ORGANIZATION_SLUG=devweekends
DEFAULT_ORGANIZATION_NAME=Dev Weekends
# Comma-separated account emails allowed to edit the global external app catalog
# (/api/apps/catalog). Stand-in until the platform super-admin role exists; empty = nobody.
PLATFORM_ADMIN_EMAILS=

# Edorax course integration. The Backend URL and Frontend URL are set per app in
# Platform -> Apps; each workspace enters its own access/secret keys in
# Settings -> Apps (stored encrypted with AI_ENCRYPTION_KEY).

# Set true to stop the 15-minute background progress sync for course tasks.
COURSE_SYNC_DISABLED=false

# ── Database (DigitalOcean managed Postgres) ──
# MUST include ?sslmode=require for DO managed databases.
DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require

# ── Auth (JWT) — generate long random strings: `openssl rand -hex 48` ──
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Self-hosted Jitsi (room-scoped JWT; secret must match Prosody) ──
JITSI_DOMAIN=meet.pathment.me
JITSI_APP_ID=pathment
JITSI_APP_SECRET=
JITSI_TOKEN_TTL_SECONDS=14400

# ── Image uploads (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max upload size in bytes (optional)
MAX_FILE_SIZE=5242880

# ── AI provider (Groq / OpenAI-compatible) ──
AI_API_KEY=
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=https://api.groq.com/openai/v1
# Encrypts users' bring-your-own AI keys at rest — generate: `openssl rand -hex 32`
AI_ENCRYPTION_KEY=
# Free-tier-safe roadmap generation limits
AI_ROADMAP_MAX_TOTAL_TOKENS=5800
AI_ROADMAP_OUTPUT_TOKENS=1200
AI_ROADMAP_MIN_OUTPUT_TOKENS=500
AI_ROADMAP_CHUNK_WEEKS=2

# ── Email (Resend) + the DB-backed email queue ──
RESEND_API_KEY=
RESEND_FROM=Pathment <noreply@pathment.me>
RESEND_REPLY_TO=support@pathment.me
# Verifies the Resend bounce/complaint webhook at POST /webhooks/resend
RESEND_WEBHOOK_SECRET=
# Mail sent TO the domain (hello@, support@) is forwarded to this one address.
# Must NOT be on a domain we receive for, or it loops. Unset = no forwarding.
INBOUND_FORWARD_TO=
# Notification email gating
EMAIL_NOTIFICATION_EMAILS_ENABLED=false
EMAIL_DISABLED_EVENTS=
# ── Sending limits (guardrails, NOT targets) ──
# These cap how much the queue will send before deferring to the next UTC day,
# so a bug can't burn your whole Resend quota in one go. Size them to your plan:
#   Resend Free = 100/day, 3k/mo   → EMAIL_DAILY_LIMIT=100
#   Resend Pro  = 50k/mo (~1.6k/day avg) → 5000 gives campaign burst headroom
# while still capping a runaway loop. Raise only if a real send needs more.
EMAIL_DAILY_LIMIT=5000
# Per-person cap so one recipient can't be spammed by a loop. 20/day is plenty.
EMAIL_DAILY_LIMIT_PER_RECIPIENT=20
# ── Worker tuning ──
# Sends are sequential (≈3–7/s actual), so batch is the claim size, not
# concurrency. Lower poll + modest batch drains a big queue steadily without
# tripping Resend's ~10 req/s rate limit.
EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH=25
# More retries = more resilience to transient 429/5xx during large campaigns.
EMAIL_MAX_ATTEMPTS=6

# ── Registration invites ──
REGISTRATION_INVITE_EXPIRY_HOURS=72

# ── Rate limiting (optional) ──
# GLOBAL backstop on /api only — the auth/login/intake limits are per-route and
# not configurable here. Leave these UNSET unless you have a specific reason: the
# defaults in src/config/index.js are the sized values. This file previously
# shipped 300, which is below what one dashboard load plus polling sends, so any
# environment seeded from it rate-limited its own users.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=3000        # reads (GET/HEAD) per window per user
# RATE_LIMIT_MAX_WRITE_REQUESTS=600   # writes (POST/PATCH/PUT/DELETE) per window

# ── Background schedulers (optional toggles / timing) ──
# NOTIFICATION_SCHEDULER_DISABLED=false
# Pause these during controlled API-only staging verification.
# EMAIL_WORKER_DISABLED=false
# RAG_WORKERS_DISABLED=false
# CERTIFICATE_WORKER_DISABLED=false
# GAMIFICATION_BOOTSTRAP_DISABLED=false
# WEEKLY_REPORT_DAY=1
# WEEKLY_REPORT_HOUR_UTC=8
# COMMUNITY_STANDUP_DAY=1
# COMMUNITY_STANDUP_HOUR_UTC=9

# ── RAG Tuning ──
# Threshold above which RAG replies are auto-sent directly to mentees
RAG_AUTO_REPLY_THRESHOLD=0.85
# Threshold above which RAG replies are saved as mentor drafts for review
RAG_DRAFT_THRESHOLD=0.50
# Minimum character difference for learning edit analysis
RAG_MIN_EDIT_DISTANCE=5
# Character size for chunking document files
RAG_CHUNK_SIZE=250
# Overlap character size between contiguous chunks
RAG_CHUNK_OVERLAP=50
# Model used to generate embeddings
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Embeddings dimension size (must match DB schema limit)
RAG_EMBEDDING_DIMENSIONS=768
# Minimum cosine similarity cutoff to count vector matches (helps filter out irrelevant chats)
RAG_MIN_SIMILARITY=0.70

# ── GitHub Integration ──
# Optional GitHub Personal Access Token to increase rate limits for open-source organization search (30 req/min vs 10 req/min)
GITHUB_TOKEN=your_github_personal_access_token_here

# Restricted staging identity/plan demo only. Requires APP_URL exactly
# https://staging.pathment.me and MULTI_TENANT_WORKSPACES_ENABLED=false.
# Does not enable teaching, certificates, messaging, realtime or workspace creation.
STAGING_WORKSPACE_DEMO=false
